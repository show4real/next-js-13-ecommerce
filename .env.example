# ---------------------------------------------------------------------------
# Google Business reviews (Customer Reviews section)
# ---------------------------------------------------------------------------
# Server-only key + Place ID used by app/api/google-reviews/route.js.
# When BOTH are set, the homepage "What Our Customers Say" section shows live
# Google reviews; otherwise it falls back to the curated testimonials.
#
# How to get these:
#   1. Google Cloud Console → create/select a project.
#   2. APIs & Services → Library → enable "Places API (New)".
#   3. APIs & Services → Credentials → Create credentials → API key.
#      Restrict it to the Places API (and your domain for the production key).
#   4. Find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
#      (search your business name; copy the "Place ID" string).
#
# NOTE: Google returns a maximum of 5 reviews per place — this is a Google limit.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional: public "see all / write a review" link shown on the reviews button.
# Falls back to a Google search for the business name when unset.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
