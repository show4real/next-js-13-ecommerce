<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1c3079"/>
      <stop offset="1" stop-color="#0E1B4D"/>
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="64" height="64" rx="14" fill="url(#g)"/>

  <!-- Creative H -->
  <rect x="12.5" y="22.5" width="4.5" height="15" rx="2.25" fill="#ffffff"/>
  <rect x="22" y="22.5" width="4.5" height="15" rx="2.25" fill="#ffffff"/>
  <polygon points="17,32.2 22,28.8 22,31.8 17,35.2" fill="#FF7A1A"/>

  <!-- CR -->
